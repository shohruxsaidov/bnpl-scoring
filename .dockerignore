# Keep the build context small — the repo root holds a multi-GB all.sql dump.
*.sql
*.dump

# Dependencies & build output (reinstalled/rebuilt inside the image)
**/node_modules
**/dist
**/.turbo
.turbo

# VCS & local tooling
.git
.gitignore
.github

# Env & secrets (build args are passed via compose, not files)
.env
.env.*
**/.env
**/.env.*

# Docker / compose definitions
Dockerfile*
docker-compose*.yml
.dockerignore

# Logs, OS cruft, editor
*.log
**/.DS_Store
.DS_Store
.vscode
.idea
.claude
