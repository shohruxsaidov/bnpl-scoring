# syntax=docker/dockerfile:1

# Stage 1 (build): compiles all three Vite/Vue frontends in one turbo run.
# Stage 2 (serve): one nginx container serves all three built SPAs.

FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.20.0 --activate
WORKDIR /app

# ---- deps ----
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json turbo.json ./
COPY apps/api/package.json             apps/api/package.json
COPY apps/admin-portal/package.json    apps/admin-portal/package.json
COPY apps/merchant-portal/package.json apps/merchant-portal/package.json
COPY apps/client-portal/package.json   apps/client-portal/package.json
COPY packages/types/package.json       packages/types/package.json
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# ---- build: all three frontends in one pass ----
FROM deps AS build
ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=$VITE_API_URL
COPY . .
RUN pnpm turbo run build \
    --filter=./apps/admin-portal \
    --filter=./apps/merchant-portal \
    --filter=./apps/client-portal

# ---- serve: one nginx, three apps ----
FROM nginx:1.27-alpine AS serve
COPY --from=build /app/apps/admin-portal/dist    /usr/share/nginx/html/admin
COPY --from=build /app/apps/merchant-portal/dist /usr/share/nginx/html/merchant
COPY --from=build /app/apps/client-portal/dist   /usr/share/nginx/html/client
COPY nginx.frontend.conf /etc/nginx/nginx.conf
EXPOSE 4001 4002 4003
