# Copy to .env for `docker compose`. Values are optional — the compose file
# falls back to the same defaults if a variable is unset.

# --- Postgres ---
POSTGRES_USER=scoring
POSTGRES_PASSWORD=scoring
POSTGRES_DB=scoring
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- API (apps/api) ---
API_PORT=4000
JWT_SECRET=                 # generate: openssl rand -hex 32

# Real PlumGate / KATM integrations are used by default. Put PLUM_* / KATM_*
# apps/api/.env — it is loaded into the api container via env_file.

# --- Frontends (host ports -> container :80) ---
PLATFORM_ADMIN_PORT=4001
MERCHANT_APP_PORT=4002
CLIENT_PORTAL_PORT=4003

# Note: MyID / PlumGate / KATM / MinIO / OTEL settings are read from
# apps/api/.env (loaded via env_file). DATABASE_URL and REDIS_URL are set
# automatically by docker-compose to point at the postgres/redis services.
