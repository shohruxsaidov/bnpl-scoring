VITE_API_URL=/api/v1

# Raster tile source for the merchant Address map. Optional — the app falls back to
# the Yandex tile URL baked into src/components/branch-map.vue. That URL pins a
# Yandex build stamp (v=...) which Yandex retires without notice; when the map goes
# blank, set a fresh URL here rather than shipping a new frontend build.
# VITE_MAP_TILE_URL=https://core-renderer-tiles.maps.yandex.net/tiles?l=map&v=22.05.23-0-b220520184800&x={x}&y={y}&z={z}&scale=2&lang=ru_RU
