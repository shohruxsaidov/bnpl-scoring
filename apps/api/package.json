{
  "name": "@scoring/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias && cp -R src/assets dist/assets",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed:banks": "tsx src/scripts/seed-bank-mfo.ts",
    "seed:regions": "tsx src/scripts/seed-regions.ts",
    "seed:scoring-model": "tsx src/scripts/seed-scoring-model.ts",
    "seed:users": "tsx src/scripts/seed-users.ts",
    "backfill:scoring-models": "tsx src/scripts/backfill-scoring-models.ts"
  },
  "dependencies": {
    "@bull-board/api": "8.0.1",
    "@bull-board/fastify": "8.0.1",
    "@fastify/compress": "^9.0.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/otel": "^0.18.1",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/instrumentation-http": "^0.218.0",
    "@opentelemetry/instrumentation-undici": "^0.28.0",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@sinclair/typebox": "^0.34.49",
    "argon2": "^0.44.0",
    "bullmq": "^5.78.0",
    "dotenv": "^16.0.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "ioredis": "^5.11.0",
    "ky": "^2.0.2",
    "minio": "^8.0.7",
    "pdfkit": "^0.18.0",
    "pino": "^10.3.1",
    "pino-loki": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.0",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}