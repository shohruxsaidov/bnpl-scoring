NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
JWT_SECRET=replace_with_a_random_string_at_least_32_chars
JWT_EXPIRES_IN=15m
SESSION_EXPIRES_DAYS=30

# This API's own internet-reachable origin. Used to build absolute URLs for
# non-same-origin clients (the mobile app renders merchant logos from these).
# Must point at the real host in every deployed environment.
PUBLIC_BASE_URL=http://localhost:4000

# MyID integration
MYID_WEB_BASE_URL=https://myid.uz
MYID_WEB_IFRAME_URL=https://myid.uz/iframe
MYID_WEB_CLIENT_ID=your_client_id
MYID_WEB_CLIENT_SECRET=your_client_secret

# Redis
REDIS_URL=redis://localhost:6379

# MinIO file storage
MINIO_ENDPOINT=46.224.27.161
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=scoring-documents
# Browser-reachable endpoint used for presigned URLs (set when MINIO_ENDPOINT
# is only reachable from inside Docker, e.g. host.docker.internal)
# MINIO_PUBLIC_ENDPOINT=files.example.uz
# MINIO_PUBLIC_PORT=443
# MINIO_PUBLIC_USE_SSL=true

# PlumGate card integration
PLUM_BASE_URL=https://pay.myuzcard.uz/api
PLUM_LOGIN=your_plum_login
PLUM_PASSWORD=your_plum_password
PLUM_TIMEOUT=15000
PLUM_TEMPLATE_ID=123
# Set to true to bypass the real Plumgate API and return mock data

# KATM credit bureau — Retail API (ADR-0025)
# NB: testapi.* is the TEST environment, api.* is PROD (the vendor PDF labels are swapped)
KATM_BASE_URL=https://testapi.infokredit.uz/katm-api/v1
KATM_LOGIN=your_katm_login
KATM_PASSWORD=your_katm_password
# Org identity assigned by KATM (pCode / pHead)
KATM_CODE=20659
KATM_HEAD=RET
# pReportId for the InfoScore 077 report
KATM_REPORT_ID=77
# Run report 315 (MIB — Бюро принудительного исполнения) as a knockout before
# the chargeable 077. Off by default; enable deliberately after test-env checks.
# Fixed applied amount/term sent at claim registration (ADR-0025)
KATM_CLAIM_AMOUNT_TIYIN=30000000
# Async report polling (result 05050) — KATM mandates >=60s between checks
KATM_POLL_INTERVAL_MS=60000
KATM_POLL_MAX_ATTEMPTS=15
KATM_TIMEOUT=20000
# Set to true to bypass the real KATM API and return mock data

# Firebase Cloud Messaging — client push notifications (inbox mirror + admin
# hand-written pushes from the client detail page). Base64 of the service-account
# JSON. Unset = messaging is null and every push silently no-ops.
#   base64 -i service-account.json | tr -d "\n"
FIREBASE_SERVICE_ACCOUNT_BASE64=
