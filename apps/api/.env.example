NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
JWT_SECRET=replace_with_a_random_string_at_least_32_chars
JWT_EXPIRES_IN=15m
SESSION_EXPIRES_DAYS=30

# MyID integration
MYID_WEB_BASE_URL=https://myid.uz
MYID_WEB_IFRAME_URL=https://myid.uz/iframe
MYID_WEB_REDIRECT_URI=https://your-merchant-app.com/myid/callback
MYID_WEB_CLIENT_ID=your_client_id
MYID_WEB_CLIENT_SECRET=your_client_secret

# Redis
REDIS_URL=redis://localhost:6379

# MinIO file storage
MINIO_ENDPOINT=46.224.27.161
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=scoring-documents

# PlumGate card integration
PLUM_BASE_URL=https://pay.myuzcard.uz/api
PLUM_LOGIN=your_plum_login
PLUM_PASSWORD=your_plum_password
PLUM_TIMEOUT=15000
PLUM_TEMPLATE_ID=123
# Set to true to bypass the real Plumgate API and return mock data
PLUM_MOCK=false

# KATM credit bureau
KATM_BASE_URL=https://api.katm.uz
KATM_LOGIN=your_katm_login
KATM_PASSWORD=your_katm_password
KATM_TIMEOUT=20000
# Set to true to bypass the real KATM API and return mock data
KATM_MOCK=false
