meta {
  name: Create Merchant Product
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/admin/merchants/:id/products
  body: json
  auth: none
}

params:path {
  id: 1
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "categoryId": "1",
    "name": "Samsung TV 55\"",
    "tanNarxi": "5000000.00",
    "mxikCode": "12345678901234567",
    "packageCode": 796,
    "packageName": "dona"
  }
}

docs {
  tanNarxi is the cost price in tiyin as a decimal string (e.g. "5000000.00").
}
