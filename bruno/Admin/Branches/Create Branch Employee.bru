meta {
  name: Create Branch Employee
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/admin/branches/:id/employees
  body: json
  auth: none
}

params:path {
  id: 1
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "agent@merchant.com",
    "password": "secure-password",
    "fullName": "John Agent",
    "roles": ["agent"]
  }
}

docs {
  roles accepts "agent" or "merchant_admin".
}
