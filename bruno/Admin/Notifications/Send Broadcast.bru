meta {
  name: Send Broadcast
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/admin/notifications/broadcast
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "targetType": "all_clients",
    "title": "Notification Title",
    "body": "Notification body text"
  }
}

docs {
  Requires send_notifications permission.
  targetType: "employee" | "merchant_employees" | "client" | "all_clients"
  targetId required for employee, merchant_employees, client — omit for all_clients.
}
