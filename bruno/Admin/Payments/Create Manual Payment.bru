meta {
  name: Create Manual Payment
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/admin/payments/manual
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "dealId": "uuid-here",
    "amount": 500000,
    "paymentType": "mib",
    "note": "Optional note"
  }
}

docs {
  Requires manage_payments permission. paymentType: "mib" | "transfer". amount in tiyin (integer).
  Returns 400 OVERPAYMENT if amount exceeds remaining balance.
}
