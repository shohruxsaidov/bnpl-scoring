meta {
  name: Create Admin User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/admin/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "newadmin@example.com",
    "fullName": "New Admin",
    "password": "secure-password",
    "roleId": "1"
  }
}

docs {
  Requires manage_admins permission. Email must be unique.
}
