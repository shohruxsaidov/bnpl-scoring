meta {
  name: Set Role Permissions
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/v1/admin/permissions/roles/:id/permissions
  body: json
  auth: none
}

params:path {
  id: 1
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "features": ["view_deals", "view_merchants", "view_payments"]
  }
}

docs {
  Replaces all permissions for the role (full replacement, not merge). Non-Superadmins cannot grant features they do not themselves hold.
}
