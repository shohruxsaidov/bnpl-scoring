meta {
  name: Select Role
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/merchant/select-role
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "pickerToken": "<pickerToken from Login response>",
    "role": "agent"
  }
}

docs {
  Used when login returns requiresRolePicker: true. role must be one of the employee's assigned roles.
}
