meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/merchant/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "employee@merchant.com",
    "password": "secret123"
  }
}

docs {
  If employee has a single role, sets merchant_access_token + merchant_session_id cookies.
  If employee has multiple roles, returns requiresRolePicker: true with a pickerToken — call /select-role next.
}
