meta {
  name: Create Admin User
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/admin/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "newadmin@example.com",
    "password": "secure-password",
    "fullName": "New Admin",
    "roleId": "1"
  }
}

docs {
  Requires manage_admins permission. Only a Superadmin may create another Superadmin.
}
