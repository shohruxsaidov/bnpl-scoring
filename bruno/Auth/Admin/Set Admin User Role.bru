meta {
  name: Set Admin User Role
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/v1/auth/admin/users/:id/role
  body: json
  auth: none
}

params:path {
  id: 1
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "roleId": "2"
  }
}

docs {
  Requires manage_admins permission. Cannot demote the last Superadmin.
}
