meta {
  name: Register - Complete
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/client/register/complete
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "regToken": "<regToken from /register/pinfl>",
    "myidCode": "<auth_code from MyID callback>"
  }
}

docs {
  Exchanges MyID code, verifies PINFL match, creates the User record. Sets access_token + session_id cookies.
}
