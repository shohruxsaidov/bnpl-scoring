meta {
  name: Register - Complete
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/client/register/complete
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "regToken": "{{regToken}}",
    "myidCode": "<auth_code from MyID callback>",
    "device": {
      "deviceId": "test-device-001",
      "fcmToken": "fcm-token-placeholder",
      "platform": "android",
      "appVersion": "1.0.0"
    }
  }
}

tests {
  const data = res.getBody();
  if (data?.accessToken) bru.setVar('accessToken', data.accessToken);
  if (data?.sessionToken) bru.setVar('sessionToken', data.sessionToken);
}

docs {
  Exchanges MyID code, verifies PINFL match, creates the User record. Returns { accessToken, sessionToken, user }. device is optional but should always be sent from the app.
}
