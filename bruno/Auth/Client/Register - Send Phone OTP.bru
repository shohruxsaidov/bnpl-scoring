meta {
  name: Register - Send Phone OTP
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/client/register/phone
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "901234567"
  }
}

docs {
  Phone can be 9-digit national or full E.164 (+998XXXXXXXXX). Returns devOtp in non-production.
}
