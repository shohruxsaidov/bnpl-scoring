meta {
  name: Login - Verify OTP
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/client/login/otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{phoneNumber1}}",
    "code": "{{otpCode}}"
  }
}

docs {
  Sets access_token + session_id cookies on success.
}
