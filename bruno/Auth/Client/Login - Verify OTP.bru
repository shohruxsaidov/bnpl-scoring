meta {
  name: Login - Verify OTP
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/client/login/otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{phoneNumber1}}",
    "code": "{{otpCode}}",
    "device": {
      "deviceId": "test-device-001",
      "fcmToken": "fcm-token-placeholder",
      "platform": "android",
      "appVersion": "1.0.0"
    }
  }
}

tests {
  const data = res.getBody();
  if (data?.accessToken) bru.setVar('accessToken', data.accessToken);
  if (data?.sessionToken) bru.setVar('sessionToken', data.sessionToken);
}

docs {
  Returns { accessToken, sessionToken, user }. device is optional but should always be sent from the app.
}
