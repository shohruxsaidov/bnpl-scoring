meta {
  name: Register - Verify OTP
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/client/register/otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{phoneNumber1}}",
    "code": "{{otpCode}}"
  }
}

script:post-response {
  const data = res.getBody(); 
  
  if(data?.regToken) {
    bru.setVar('regToken', data.regToken)
  }
}

docs {
  Returns a regToken (phase 1 — phone_verified, 15 min TTL). Pass it to /register/pinfl.
}
