meta {
  name: Refresh
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/auth/client/refresh
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "sessionToken": "{{sessionToken}}"
  }
}

tests {
  const data = res.getBody();
  if (data?.accessToken) bru.setVar('accessToken', data.accessToken);
}

docs {
  Send sessionToken in body. Returns { accessToken } with a fresh 15-min JWT.
}
