meta {
  name: Login - Send OTP
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/client/login/phone
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "{{phoneNumber1}}"
  }
}

tests {
  const data = res.getBody()
  
  if(data.devOtp) {
    bru.setVar('otpCode',data.devOtp)
  }
}
