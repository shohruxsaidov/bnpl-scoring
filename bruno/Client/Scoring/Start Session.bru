meta {
  name: Start Session
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/client/scoring/start
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "consentId": "consent-id-from-ui",
    "consentDate": "2026-06-02"
  }
}

docs {
  Creates a Scoring Session and runs KATM. Returns katm result + sessionId.
  The card_scoring pipeline stays 'pending' until the client adds their card.
}
