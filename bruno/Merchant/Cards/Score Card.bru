meta {
  name: Score Card
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/merchant/cards/score
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "plumCardId": "<plumCardId from confirmed card>",
    "pcType": "uzcard"
  }
}

docs {
  Runs PlumGate scoring for the confirmed card. pcType: "uzcard" | "humo".
  Returns { score, limit, decision }.
}
