meta {
  name: Add Card
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/merchant/cards/add
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "clientId": "1",
    "cardNumber": "8600123456789012",
    "expiry": "0126"
  }
}

docs {
  Registers the card in PlumGate. Sends OTP to the client's phone.
  Returns { sessionId, maskedPhone }. Pass sessionId to /confirm.
}
