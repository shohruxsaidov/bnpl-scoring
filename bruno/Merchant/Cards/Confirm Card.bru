meta {
  name: Confirm Card
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/merchant/cards/confirm
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "sessionId": "<sessionId from /add>",
    "otp": "123456"
  }
}

docs {
  Confirms the OTP to complete card registration. Returns the confirmed card details.
}
