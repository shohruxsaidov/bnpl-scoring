meta {
  name: Create Employee
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/merchant/employees
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "agent@merchant.com",
    "password": "secure-password",
    "fullName": "Agent Name",
    "branchId": "1",
    "roles": ["agent"]
  }
}

docs {
  Requires manage_employees permission. Merchant Admins can only create Agents.
}
