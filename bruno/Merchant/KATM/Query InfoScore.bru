meta {
  name: Query InfoScore
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/merchant/katm/query
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "clientId": "1"
  }
}

docs {
  Runs a KATM InfoScore 077 request for the given client (looked up by clientId → PINFL).
  Returns score, scoringClass, scoringLevel, activeLoans, allDebtSum, overdueCount, etc.
}
