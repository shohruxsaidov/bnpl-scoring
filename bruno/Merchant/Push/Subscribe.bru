meta {
  name: Subscribe
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/merchant/push/subscribe
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "endpoint": "https://fcm.googleapis.com/fcm/send/...",
    "p256dh": "<base64url key>",
    "auth": "<base64url auth>"
  }
}

docs {
  Registers a Web Push subscription for this employee. Upserts on endpoint.
}
