meta {
  name: Send OTP
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/merchant/client/otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "901234567"
  }
}

docs {
  Sends a client_registration OTP to the given phone. Returns devOtp in non-production.
}
