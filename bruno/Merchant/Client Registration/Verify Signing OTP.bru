meta {
  name: Verify Signing OTP
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/merchant/client/sign-otp/verify
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": "901234567",
    "code": "123456"
  }
}

docs {
  Returns signingToken (10 min TTL). Pass this to POST /merchant/deals as proof of client consent.
}
