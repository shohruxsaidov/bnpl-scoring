meta {
  name: Complete MyID Signing
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/merchant/client/myid-sign-complete
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "signingSessionToken": "<from /myid-sign-session>",
    "myidCode": "<auth_code from MyID callback>",
    "signingToken": "<from /sign-otp/verify>",
    "clientId": "1",
    "tariffId": "1",
    "basket": [
      { "productId": "1", "quantity": 1 }
    ],
    "paymentDay": 15,
    "scoreSum": 75,
    "scoringDecision": "approved"
  }
}

docs {
  Single-call endpoint for the MyID signing callback. Verifies OTP consent + MyID identity, then creates the deal atomically.
  Returns { verified: true, dealId }.
}
