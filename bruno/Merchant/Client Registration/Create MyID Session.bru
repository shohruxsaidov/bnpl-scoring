meta {
  name: Create MyID Session
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/merchant/client/myid-session
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "regToken": "<regToken from /otp/verify>",
    "pinfl": "12345678901234",
    "retry": false
  }
}

docs {
  Checks client is not already registered under this merchant. Creates MyID session.
  Returns regToken (phase 2) + redirectUrl for MyID iframe.
}
