# Copy to .env and fill in values before running docker compose up

# Application — blue/green slots (managed by deploy.sh)
BLUE_TAG=latest          # active slot on first boot
GREEN_TAG=latest         # idle slot; deploy.sh updates this before switching
# CANARY_TAG=            # set when activating a canary deployment
DATABASE_URL=postgresql://scoring:changeme@postgres:5432/scoring
JWT_SECRET=              # generate: openssl rand -hex 32

# PostgreSQL
POSTGRES_DB=scoring
POSTGRES_USER=scoring
POSTGRES_PASSWORD=       # set a strong password

# Grafana
GRAFANA_PASSWORD=        # set a strong password
