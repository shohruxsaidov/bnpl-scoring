# Copy to .env.infra for `docker compose -f docker-compose.infra.yml --env-file .env.infra up -d`
# All values are optional — the compose file falls back to the same defaults.

# --- PostgreSQL 17 ---
POSTGRES_USER=scoring
POSTGRES_PASSWORD=scoring
POSTGRES_DB=scoring
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Garage (S3-compatible object storage) ---
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903
GARAGE_UI_PORT=3909
# Must match admin_token in garage.toml
GARAGE_ADMIN_TOKEN=garage-admin-token

# ---------------------------------------------------------------------------
# Matching apps/api/.env settings to point at this local infra:
#
#   DATABASE_URL=postgresql://scoring:scoring@localhost:5432/scoring
#   REDIS_URL=redis://localhost:6379
#   MINIO_ENDPOINT=localhost
#   MINIO_PORT=3900
#   MINIO_USE_SSL=false
#   MINIO_ACCESS_KEY=<key-id from Garage>
#   MINIO_SECRET_KEY=<secret-key from Garage>
#   MINIO_BUCKET=scoring-documents
#
# Create a key + bucket via the Garage Web UI at http://localhost:3909
# after the cluster is initialised (see garage.toml for admin_token).
# ---------------------------------------------------------------------------
