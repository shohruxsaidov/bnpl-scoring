# syntax=docker/dockerfile:1

# Shared multi-stage build for the Vite/Vue frontends.
# Parameterized by APP_DIR (e.g. apps/client-portal) so one Dockerfile serves all three.

FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.20.0 --activate
WORKDIR /app

# ---- deps ----
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json turbo.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/client-portal/package.json apps/client-portal/package.json
COPY apps/merchant-portal/package.json apps/merchant-portal/package.json
COPY apps/admin-portal/package.json apps/admin-portal/package.json
COPY packages/types/package.json packages/types/package.json
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# ---- build: produces <APP_DIR>/dist ----
FROM deps AS build
ARG APP_DIR
ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=$VITE_API_URL
COPY . .
RUN pnpm turbo run build --filter=./${APP_DIR}...

# ---- dist: expose built assets via bind mount ----
FROM alpine:3.20 AS dist
ARG APP_DIR
COPY --from=build /app/${APP_DIR}/dist /app-dist
CMD ["sh", "-c", "cp -rp /app-dist/. /dist/"]

# ---- serve: nginx serving the SPA + /api/ proxy ----
FROM nginx:1.27-alpine AS serve
ARG APP_DIR
COPY --from=build /app/${APP_DIR}/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

